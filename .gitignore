# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
!AGENTS.md
!.github/
!.github/workflows/
!.github/workflows/*.yml

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# madori
.sessions
.madori/restore-rollbacks/
packages/*/node_modules
packages/*/dist
users/*

# CCE (code-context-engine)
# CCE local cache (per-machine, not for version control)
.cce/
# Claude Code local settings written by cce init
.claude/settings.local.json
# .mcp.json contains absolute paths regenerated by `cce init`
.mcp.json

# Disposable browser-test output and fixtures
.next-e2e/
test-results/
tests/e2e/.madori/
